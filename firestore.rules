rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrapAdmin() {
      return isSignedIn() &&
             request.auth.token.email != null &&
             (
               request.auth.token.email == 'mahmoudkowatly@gmail.com' ||
               request.auth.token.email.matches('(?i)^mahmoudkowatly@gmail\\.com$')
             );
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrapAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 128 &&
             data.role in ['admin', 'estimator', 'viewer'];
    }

    function isValidInvitation(data) {
      return data.keys().hasAll(['id', 'email', 'role', 'status']) &&
             data.keys().hasOnly(['id', 'email', 'displayName', 'role', 'status', 'passwordHash', 'salt', 'invitedBy', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 128 &&
             data.role in ['admin', 'estimator', 'viewer'] &&
             data.status in ['pending', 'active', 'suspended'];
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'ownerId', 'projectName']) &&
             data.keys().hasOnly(['id', 'ownerId', 'ownerEmail', 'projectName', 'clientName', 'orgName', 'governorate', 'refNumber', 'discountPercent', 'logoDataUrl', 'estimate', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128 &&
             data.projectName is string && data.projectName.size() >= 0 && data.projectName.size() <= 200;
    }

    // Connectivity test endpoint
    match /test/connection {
      allow read: if true;
    }

    // Admins collection - identity marker
    match /admins/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if (isAdmin() || (isSignedIn() && isBootstrapAdmin() && request.auth.uid == userId)) && isValidId(userId);
    }

    // Pre-authorized Invitations collection
    match /invitations/{invitationId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if (isAdmin() || invitationId == 'mahmoudkowatly_gmail_com') && isValidId(invitationId) && isValidInvitation(incoming());
      allow update: if isValidId(invitationId) && isValidInvitation(incoming()) && (
        isAdmin() ||
        invitationId == 'mahmoudkowatly_gmail_com' ||
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'passwordHash', 'salt', 'updatedAt'])
      );
      allow delete: if isAdmin() && isValidId(invitationId);
    }

    // User profiles & RBAC
    match /users/{userId} {
      allow get: if isSignedIn() && (resource == null || isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() ||
        userId == 'u_mahmoudkowatly_gmail_com' ||
        (isSignedIn() && isOwner(userId) && incoming().uid == request.auth.uid && incoming().role != 'admin') ||
        (incoming().role != 'admin')
      );

      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() ||
        (isOwner(userId) && incoming().uid == request.auth.uid && incoming().role == existing().role)
      );

      allow delete: if isAdmin() && isValidId(userId);
    }

    // BOQ Projects collection
    match /projects/{projectId} {
      allow get: if (resource == null || resource.data.ownerId == request.auth.uid || isAdmin() || isSignedIn());
      allow list: if (isAdmin() || resource.data.ownerId == request.auth.uid || isSignedIn());

      allow create: if isValidId(projectId) &&
                    isValidProject(incoming());

      allow update: if isValidId(projectId) &&
                    isValidProject(incoming());

      allow delete: if isValidId(projectId);
    }
  }
}
