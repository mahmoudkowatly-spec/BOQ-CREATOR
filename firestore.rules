rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedSignedIn() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrapAdmin() {
      return isVerifiedSignedIn() &&
             request.auth.token.email != null &&
             request.auth.token.email.matches('(?i)^mahmoudkowatly@gmail\\.com$');
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrapAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 128 &&
             data.role in ['admin', 'estimator', 'viewer'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('status' in data) || data.status in ['active', 'pending', 'suspended']) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 128 &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidInvitation(data) {
      return data.keys().hasAll(['id', 'email', 'role', 'status']) &&
             data.keys().hasOnly(['id', 'email', 'displayName', 'role', 'status', 'passwordHash', 'salt', 'invitedBy', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 128 &&
             data.role in ['admin', 'estimator', 'viewer'] &&
             data.status in ['pending', 'active', 'suspended'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 128)) &&
             (!('salt' in data) || (data.salt is string && data.salt.size() <= 128)) &&
             (!('invitedBy' in data) || (data.invitedBy is string && data.invitedBy.size() <= 128)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'ownerId', 'projectName']) &&
             data.keys().hasOnly(['id', 'ownerId', 'ownerEmail', 'projectName', 'clientName', 'orgName', 'governorate', 'refNumber', 'discountPercent', 'logoDataUrl', 'estimate', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128 &&
             data.projectName is string && data.projectName.size() <= 200 &&
             (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 128)) &&
             (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 200)) &&
             (!('orgName' in data) || (data.orgName is string && data.orgName.size() <= 200)) &&
             (!('governorate' in data) || (data.governorate is string && data.governorate.size() <= 100)) &&
             (!('refNumber' in data) || (data.refNumber is string && data.refNumber.size() <= 100)) &&
             (!('discountPercent' in data) || (data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 100)) &&
             (!('logoDataUrl' in data) || (data.logoDataUrl is string && data.logoDataUrl.size() <= 500000)) &&
             (!('estimate' in data) || (data.estimate is list && data.estimate.size() <= 5000)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Connectivity test endpoint
    match /test/connection {
      allow get: if true;
    }

    // Admins collection - identity marker
    match /admins/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && isValidId(userId) && isValidAdminRecord(incoming()) && (
        isAdmin() ||
        (isBootstrapAdmin() && request.auth.uid == userId && incoming().uid == request.auth.uid)
      );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Pre-authorized Invitations collection
    match /invitations/{invitationId} {
      // Single-document lookup by deterministic normalized email key for login authorization check
      allow get: if isValidId(invitationId);
      allow list: if isAdmin();

      // Only verified admins can create invitations (plus one-time bootstrap admin record creation if absent)
      allow create: if isValidId(invitationId) && isValidInvitation(incoming()) && (
        isAdmin() ||
        (invitationId == 'mahmoudkowatly_gmail_com' &&
         incoming().id == 'mahmoudkowatly_gmail_com' &&
         incoming().email == 'mahmoudkowatly@gmail.com' &&
         incoming().role == 'admin')
      );

      // Update actions:
      // 1) Verified Admin can perform any valid update
      // 2) Pre-authorized engineer in 'pending' state can activate & set initial/reset password once
      // 3) Verified Google-authenticated owner of the invitation email (non-suspended) can mark active
      allow update: if isValidId(invitationId) && isValidInvitation(incoming()) && (
        isAdmin() ||
        (
          existing().status == 'pending' &&
          incoming().status == 'active' &&
          incoming().passwordHash is string && incoming().passwordHash.size() > 0 &&
          incoming().salt is string && incoming().salt.size() > 0 &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'passwordHash', 'salt', 'updatedAt'])
        ) ||
        (
          isVerifiedSignedIn() &&
          request.auth.token.email != null &&
          request.auth.token.email.lower() == existing().email.lower() &&
          existing().status != 'suspended' &&
          incoming().status == 'active' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
      );

      allow delete: if isAdmin() && isValidId(invitationId);
    }

    // User profiles & RBAC
    match /users/{userId} {
      allow get: if isSignedIn() && (resource == null || isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() ||
        (isOwner(userId) && incoming().uid == request.auth.uid && incoming().role != 'admin')
      );

      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() ||
        (isOwner(userId) &&
         incoming().uid == existing().uid &&
         incoming().role == existing().role &&
         incoming().status == existing().status &&
         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
      );

      allow delete: if isAdmin() && isValidId(userId);
    }

    // BOQ Projects collection
    match /projects/{projectId} {
      allow get: if isSignedIn() && (resource == null || existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                    isValidId(projectId) &&
                    isValidProject(incoming()) &&
                    (incoming().ownerId == request.auth.uid || isAdmin());

      allow update: if isSignedIn() &&
                    isValidId(projectId) &&
                    isValidProject(incoming()) &&
                    (
                      isAdmin() ||
                      (existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId)
                    );

      allow delete: if isSignedIn() &&
                    isValidId(projectId) &&
                    (isAdmin() || existing().ownerId == request.auth.uid);
    }
  }
}
